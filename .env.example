# MongoDB 连接（留空则回落到本地默认，配置/历史不持久化）
# 本地：  mongodb://127.0.0.1:27017
# 云端 Atlas 示例（把 <PASSWORD> 换成真实密码、<cluster> 换成你的集群地址，数据库会建在 MONGODB_DB 指定的库，不会落到 test）：
# MONGODB_URI=mongodb://<user>:<PASSWORD>@<cluster>-shard-00-00.<xxxx>.mongodb.net:27017,<cluster>-shard-00-01.<xxxx>.mongodb.net:27017,<cluster>-shard-00-02.<xxxx>.mongodb.net:27017/?ssl=true&replicaSet=atlas-<xxxx>-shard-0&authSource=admin&appName=app
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=torrent_console

# 站点访问密码（留空则站点完全开放；设置后进入站点需在 /gate 输入此密码，cookie 由服务端校验）
# 同一 IP 输错 5 次锁定 1 小时
WEBPASSWORD=

# 访问搜索源时使用的 HTTP 代理（国内网络连不上公开磁力站时配这里）
# 例如：http://127.0.0.1:7890
SEARCH_PROXY=

# 超时（毫秒）
SEARCH_TIMEOUT=12000
METADATA_TIMEOUT=30000

# 各搜索源基地址（一般无需修改）
APIBAY_BASE=
NYAA_BASE=
CILISOUSUO_BASE=

# 生产运行监听（仅直接运行 .output 时需要）
HOST=0.0.0.0
PORT=3000
